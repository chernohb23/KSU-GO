{
  "name": "ksugo-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:app": "npm run build && node scripts/export-html.mjs ../app/src/viewerHtml.ts",
    "check:app": "npm run build && node scripts/check-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
